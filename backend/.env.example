# Reference values for local runs. config.py reads os.environ only (no .env loader), so set these
# in the shell before starting uvicorn. No secrets belong here: auth is ADC.
GOOGLE_CLOUD_PROJECT=sanpolab
GOOGLE_CLOUD_LOCATION=global
GEMINI_FLASH_MODEL=gemini-3.8-flash
# 語りで Search grounding の最初のトークンを待つ秒数。過ぎたら grounding なしで呼び直す（D-32）
NARRATE_FIRST_TOKEN_TIMEOUT=12
GEMINI_PRO_MODEL=
ALLOWED_ORIGINS=http://localhost:3000
FIRESTORE_DISABLED=1
STORAGE_DISABLED=1
PHOTO_BUCKET=sanpolab-photos
